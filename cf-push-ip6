# ============================================================
# IPv6-only variant of cf-push-ip: pushes this instance's public
# IPv6 plus a timestamped comment to a Cloudflare AAAA record,
# but only when the address has actually changed. Meant to run
# every 5 minutes (plus once at startup):
#   /system scheduler add name=cf-push-ip6 start-time=startup \
#     interval=5m policy=read,test,sensitive,policy \
#     on-event="/system script run cf-push-ip6"
#   ...or, if the entry already exists, set rather than add:
#   /system scheduler set [find name=cf-push-ip6] interval=5m
# The scheduler is the retry mechanism, so a run that finds no
# usable address does nothing and leaves it to the next one -
# nothing here loops for longer than the interval.
# Run this *instead of* cf-push-ip; running both makes two
# scripts fight over the same AAAA record.
# Requires: /system clock set time-zone-name=Asia/Hong_Kong format=yyyy-MM-dd
# Requires: secret-vault (defines $SECRET) with cfpuship-apitoken,
#           cfpuship-zoneid and cfpuship-recordid6. The first two
#           are shared with cf-push-ip. Seed with:
#           $SECRET "set" "<name>" password="..."
# Policy: read, test, sensitive, policy
#         "sensitive" reads the vault; "policy" runs secret-vault.
# Source of the address: there is no NAT in IPv6, so the global
#         address on wanInterface *is* the public one. That is read
#         first - deterministic, instant, and it needs no internet.
#         ipv6.icanhazip.com is the fallback for hosts where the
#         public address does not sit on the router. It is AAAA-only
#         (the answer cannot arrive over IPv4) and Cloudflare-fronted,
#         so the same reachability class as api.cloudflare.com -
#         api6.ipify.org is blocked in China. AAAA-only alternative:
#         ipv6.ip.sb (api.ip.sb is dual stack).
#         An address ending in :: is the subnet-router anycast
#         address, not a host - it is refused rather than published.
#         Fix it with: /ipv6 address set [find from-pool=<pool>] address=::1/64
# State: $cfPushIp6Last holds the last address pushed. Inspect with
#         /system script environment print; forcing a re-push is
#         /system script environment remove [find name=cfPushIp6Last]
# ============================================================

# ---- Configurable variables ----
:local commentName   "<Name>"
:local wanInterface  "pppoe-out1"
:local ipCheckUrl6   "https://ipv6.icanhazip.com"
:local retryDelay       5s
:local pushMaxAttempts  3
:local quietEvery       12
:local heartbeatEvery   1
:local clockMaxAttempts 6
:local clockRetryDelay  5s
:local vaultMaxWait     60
:local startupDelay     5s
# ---------------------------------

:global SecretVaultReady
:global SECRET

# Everything in this block is boot-only: $SecretVaultReady is cleared by a
# reboot and set by secret-vault, so on the hundreds of later runs the script
# skips straight past it. start-time=startup fires before RouterOS is fully
# up, hence the pause; the vault is run directly rather than waiting on its
# own scheduler entry, which would otherwise be a race. The secrets persist
# in /ppp/secret - only $SECRET itself is per-boot. vaultMaxWait is in 500ms
# units.
:if ($SecretVaultReady != true) do={
  :delay $startupDelay
  :do { /system script run secret-vault } on-error={
    :log warning "cf-push-ip6: could not run secret-vault directly, falling back to waiting for it"
  }
  :local waited 0
  :while ($SecretVaultReady != true && $waited < $vaultMaxWait) do={
    :delay 500ms
    :set waited ($waited + 1)
  }
}
:if ($SecretVaultReady != true) do={
  :log error "cf-push-ip6: secret-vault not ready, cannot read credentials - aborting"
  :error "cf-push-ip6: secret-vault not ready"
}

# $SECRET "get" raises on an unknown name, so each read is wrapped; an empty
# result means the same as a missing one.
:local cfApiToken  ""
:local cfZoneId    ""
:local cfRecordId6 ""
:do { :set cfApiToken  [$SECRET "get" "cfpuship-apitoken"] } on-error={}
:do { :set cfZoneId    [$SECRET "get" "cfpuship-zoneid"] } on-error={}
:do { :set cfRecordId6 [$SECRET "get" "cfpuship-recordid6"] } on-error={}

# Unlike in cf-push-ip, a missing cfpuship-recordid6 is fatal here.
:local missing ""
:if ($cfApiToken  = "") do={ :set missing ($missing . " cfpuship-apitoken") }
:if ($cfZoneId    = "") do={ :set missing ($missing . " cfpuship-zoneid") }
:if ($cfRecordId6 = "") do={ :set missing ($missing . " cfpuship-recordid6") }
:if ($missing != "") do={
  :log error ("cf-push-ip6: missing secret(s):" . $missing . " - aborting")
  :error "cf-push-ip6: incomplete secrets"
}

# The endpoint returns the address with a trailing newline, which would end
# up inside the JSON body and be rejected, so strip anything non-address.
:local trimIp do={
  :local out ""
  :for i from=0 to=([:len $raw] - 1) do={
    :local c [:pick $raw $i]
    :if ($c != "\n" && $c != "\r" && $c != " " && $c != "\t") do={ :set out ($out . $c) }
  }
  :return $out
}

# The global address on the WAN interface, or "" if it has none yet. Skips
# link-local (fe80::) and ULA (fc00::/7), neither of which is routable.
:local readWanIp6 do={
  :local found ""
  :foreach a in=[/ipv6 address find interface=$iface] do={
    :if ($found = "") do={
      :local raw [/ipv6 address get $a address]
      :local slash [:find $raw "/"]
      :if ($slash != nil) do={ :set raw [:pick $raw 0 $slash] }
      :local head [:pick $raw 0 2]
      :if ([/ipv6 address get $a disabled] != true && [/ipv6 address get $a invalid] != true && \
           $head != "fe" && $head != "fc" && $head != "fd") do={
        :set found $raw
      }
    }
  }
  :return $found
}

# What the AAAA record currently holds, or "" if it cannot be read. Only used
# on the first run after a reboot, to avoid a pointless push when the address
# has not changed across the reboot.
:local readRecordIp6 do={
  :do {
    :local res [/tool fetch \
      url="https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$record" \
      http-header-field="Authorization: Bearer $token" \
      check-certificate=yes-without-crl \
      output=user as-value]
    :local body ($res->"data")
    :local key "\"content\":\""
    :local start [:find $body $key]
    :if ($start != nil) do={
      :set start ($start + [:len $key])
      :local end [:find $body "\"" $start]
      :if ($end != nil) do={ :return [:pick $body $start $end] }
    }
  } on-error={}
  :return ""
}

# PATCH one DNS record, returning whether it worked. do={} functions see no
# outer :local, so pass it all in.
:local pushRecord do={
  :do {
    :local updateResult [/tool fetch \
      url="https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$record" \
      http-method=patch \
      http-header-field="Content-Type: application/json,Authorization: Bearer $token" \
      http-data="{\"content\":\"$ip\",\"comment\":\"$comment\"}" \
      check-certificate=yes-without-crl \
      output=user as-value]
    :local respBody ($updateResult->"data")
    :if ([:find $respBody "\"success\":true"] != nil) do={
      :log info ("cf-push-ip6: " . $label . " record updated successfully -> " . $ip)
      :return true
    }
    :log error ("cf-push-ip6: " . $label . " update failed, response: " . $respBody)
  } on-error={
    :log error ("cf-push-ip6: HTTP request to Cloudflare API failed for " . $label . " record")
  }
  :return false
}

# One attempt per run, deliberately: if the address is not there yet the next
# run is only 5 minutes away, and looping here would stack up overlapping runs.
:local publicIp6 ""
:do { :set publicIp6 [$readWanIp6 iface=$wanInterface] } on-error={
  :log warning ("cf-push-ip6: could not read an address from " . $wanInterface . ", falling back to " . $ipCheckUrl6)
}

# Only reach out if the router has no global address of its own.
:if ($publicIp6 = "") do={
  :do {
    :local ip6Result [/tool fetch url=$ipCheckUrl6 check-certificate=yes-without-crl output=user as-value]
    :if (($ip6Result->"status") = "finished") do={
      :set publicIp6 [$trimIp raw=($ip6Result->"data")]
    }
  } on-error={}
}

# ...:: is the subnet-router anycast address of the /64, not a host, so peers
# cannot reach it. Refuse it rather than publishing an unreachable endpoint.
:local problem "no usable public IPv6 this run"
:if ([:len $publicIp6] > 1 && [:pick $publicIp6 ([:len $publicIp6] - 2) [:len $publicIp6]] = "::") do={
  :set problem ($publicIp6 . " is a subnet-router anycast address, not a host - fix the suffix, e.g. /ipv6 address set [find from-pool=<pool>] address=::1/64")
  :set publicIp6 ""
}

# Surviving the reboot that clears this costs one GET per boot, not one per
# run. Set only after a successful push, so a failed one is retried next run
# rather than remembered as done.
:global cfPushIp6Last
:global cfPushIp6Quiet
:global cfPushIp6Runs
:if ([:typeof $cfPushIp6Quiet] != "num") do={ :set cfPushIp6Quiet 0 }
:if ([:typeof $cfPushIp6Runs] != "num") do={ :set cfPushIp6Runs 0 }

:if ($publicIp6 = "") do={
  # A WAN outage would otherwise log 288 times a day, so complain on the
  # first failing run and hourly after that.
  :set cfPushIp6Quiet ($cfPushIp6Quiet + 1)
  :if ($cfPushIp6Quiet = 1) do={ :log warning ("cf-push-ip6: " . $problem) }
  :if ($cfPushIp6Quiet >= $quietEvery) do={ :set cfPushIp6Quiet 0 }
} else={
  :set cfPushIp6Quiet 0
  :local known $cfPushIp6Last
  :if ([:typeof $known] != "str") do={ :set known "" }
  :if ($known = "") do={
    :set known [$readRecordIp6 token=$cfApiToken zone=$cfZoneId record=$cfRecordId6]
  }

  :if ($known = $publicIp6) do={
    :set cfPushIp6Last $publicIp6
    # Nothing to do, but say so - or a working script and a dead one look
    # identical in the log. Every run by default; raise heartbeatEvery to
    # log one run in N instead (12 = hourly at a 5m interval).
    :set cfPushIp6Runs ($cfPushIp6Runs + 1)
    :if ($cfPushIp6Runs = 1) do={
      :log info ("cf-push-ip6: " . $publicIp6 . " unchanged, no update")
    }
    :if ($cfPushIp6Runs >= $heartbeatEvery) do={ :set cfPushIp6Runs 0 }
  } else={
    # Only now is the timestamp worth waiting for: the comment records when
    # the address last changed, and a skipped run writes no comment at all.
    :local clockAttempt 0
    :local clockOk false
    :while ($clockAttempt < $clockMaxAttempts and $clockOk = false) do={
      :set clockAttempt ($clockAttempt + 1)
      :if ([:tonum [:pick [/system clock get date] 0 4]] >= 2024) do={
        :set clockOk true
      } else={
        :delay $clockRetryDelay
      }
    }
    :if ($clockOk = false) do={
      :log warning "cf-push-ip6: clock still not synced, comment timestamp may be inaccurate"
    }

    :local todayDate [/system clock get date]
    :local nowTime   [/system clock get time]
    :local timestamp ([:pick $todayDate 2 4] . "-" . [:pick $todayDate 5 7] . "-" . [:pick $todayDate 8 10] . " " . [:pick $nowTime 0 5])
    :local cfComment ($commentName . " - " . $timestamp)

    :log info ("cf-push-ip6: address changed to " . $publicIp6 . ", updating Cloudflare (comment: $cfComment)")

    # Having an address is not proof that egress works, so the push retries -
    # but only briefly, so the run finishes well inside the 5m interval.
    :local pushed false
    :local attempt 0
    :while ($pushed = false && $attempt < $pushMaxAttempts) do={
      :set attempt ($attempt + 1)
      :set pushed [$pushRecord token=$cfApiToken zone=$cfZoneId record=$cfRecordId6 \
                   ip=$publicIp6 comment=$cfComment label="AAAA"]
      :if ($pushed = false && $attempt < $pushMaxAttempts) do={ :delay $retryDelay }
    }
    :if ($pushed = true) do={
      :set cfPushIp6Last $publicIp6
      :set cfPushIp6Runs 0
    } else={
      :log error "cf-push-ip6: giving up after $attempt failed update attempts, will retry next run"
    }
  }
}
