# ============================================================
# Push this instance's current public IPs + a timestamped comment
# to a Cloudflare A record, and to a AAAA record for the same
# subdomain if one is configured. Runs once at RouterOS startup,
# and retries indefinitely every 30s until internet connectivity
# (in the form of a successful HTTPS call out) is available.
# IPv4 gates startup; IPv6 is best-effort and skipped if either
# the AAAA secret is absent or IPv6 egress is unavailable.
# Requires: /system clock set time-zone-name=Asia/Hong_Kong format=yyyy-MM-dd
# Requires: secret-vault run at boot (it defines $SECRET), with
#           secrets cfpuship-apitoken, cfpuship-zoneid,
#           cfpuship-recordid, and optionally cfpuship-recordid6
#           for the AAAA record. Seed them from the terminal with
#           $SECRET "set" "<name>" password="..."
# Policy: read, test, sensitive
#         "sensitive" is required to read the vault: policy is
#         enforced per the running script, not per secret-vault.
# ============================================================

# ---- Configurable variables ----
:local commentName   "<Name>"
:local ipCheckUrl       "https://api.ipify.org"
:local ipCheckUrl6      "https://api6.ipify.org"
:local retryDelay       30s
:local logEveryAttempts 10
:local clockMaxAttempts 6
:local clockRetryDelay  5s
:local vaultMaxWait     60
:local startupDelay     30s
# ---------------------------------

# Scheduler entries with start-time=startup fire before RouterOS has finished
# bringing the system up. Hold off before touching anything, so the first
# fetch and the first vault read are not made against a half-initialised
# router. This is a deliberate fixed delay, not a readiness check: it costs
# 30s on every boot regardless of how fast the router actually came up.
:delay $startupDelay

# At startup this script and secret-vault's own scheduler entry race, so
# waiting for $SECRET to exist is required, not cosmetic. $SECRET lives in
# the script environment and is cleared by a reboot; the secrets themselves
# persist in /ppp/secret. vaultMaxWait is in 500ms units, so 60 = 30s - the
# startup delay above does not guarantee secret-vault has run yet, only that
# it has had a chance to.
:global SecretVaultReady
:global SECRET
:local waited 0
:while ($SecretVaultReady != true && $waited < $vaultMaxWait) do={
  :delay 500ms
  :set waited ($waited + 1)
}
:if ($SecretVaultReady != true) do={
  :log error "cf-push-ip: secret-vault not ready, cannot read credentials - aborting"
  :error "cf-push-ip: secret-vault not ready"
}

# Credentials come from the vault, never from this script's text. $SECRET
# "get" raises on an unknown name, so each read is wrapped and an empty
# result is treated the same as a missing one - both mean "unusable".
:local cfApiToken ""
:local cfZoneId   ""
:local cfRecordId ""
:do { :set cfApiToken [$SECRET "get" "cfpuship-apitoken"] } on-error={}
:do { :set cfZoneId   [$SECRET "get" "cfpuship-zoneid"] } on-error={}
:do { :set cfRecordId [$SECRET "get" "cfpuship-recordid"] } on-error={}

:local missing ""
:if ($cfApiToken = "") do={ :set missing ($missing . " cfpuship-apitoken") }
:if ($cfZoneId   = "") do={ :set missing ($missing . " cfpuship-zoneid") }
:if ($cfRecordId = "") do={ :set missing ($missing . " cfpuship-recordid") }
:if ($missing != "") do={
  :log error ("cf-push-ip: missing secret(s):" . $missing . " - aborting")
  :error "cf-push-ip: incomplete secrets"
}

# cfpuship-recordid6 is deliberately optional: without it this stays a
# pure IPv4 updater, which is what v4-only hosts want.
:local cfRecordId6 ""
:do { :set cfRecordId6 [$SECRET "get" "cfpuship-recordid6"] } on-error={}
:local doIpv6 true
:if ($cfRecordId6 = "") do={
  :set doIpv6 false
  :log info "cf-push-ip: no cfpuship-recordid6 secret, IPv6 record will not be updated"
}

# PATCH one DNS record. RouterOS do={} functions do not capture outer
# :local variables, so everything it needs is passed in explicitly.
:local pushRecord do={
  :do {
    :local updateResult [/tool fetch \
      url="https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$record" \
      http-method=patch \
      http-header-field="Content-Type: application/json,Authorization: Bearer $token" \
      http-data="{\"content\":\"$ip\",\"comment\":\"$comment\"}" \
      check-certificate=yes-without-crl \
      output=user as-value]
    :local respBody ($updateResult->"data")
    :if ([:find $respBody "\"success\":true"] != nil) do={
      :log info ("cf-push-ip: " . $label . " record updated successfully -> " . $ip)
    } else={
      :log error ("cf-push-ip: " . $label . " update failed, response: " . $respBody)
    }
  } on-error={
    :log error ("cf-push-ip: HTTP request to Cloudflare API failed for " . $label . " record")
  }
}

:local attempt 0
:local sinceLastLog 0
:local publicIp ""

:log info "cf-push-ip: waiting for internet connectivity"

:while ($publicIp = "") do={
  :set attempt ($attempt + 1)
  :do {
    :local ipResult [/tool fetch url=$ipCheckUrl check-certificate=yes-without-crl output=user as-value]
    :if (($ipResult->"status") = "finished") do={
      :set publicIp ($ipResult->"data")
    }
  } on-error={}

  :if ($publicIp = "") do={
    :set sinceLastLog ($sinceLastLog + 1)
    :if ($sinceLastLog >= $logEveryAttempts) do={
      :log warning "cf-push-ip: still no internet connectivity after $attempt attempts, retrying every $retryDelay"
      :set sinceLastLog 0
    }
    :delay $retryDelay
  }
}

:log info "cf-push-ip: internet is up, public IPv4 is $publicIp (after $attempt attempt(s))"

# Fetch the public IPv6 once, over a v6-only host so the address family is
# unambiguous. Best-effort only: a failure here means IPv6 egress is not
# working, in which case publishing an AAAA record would point the subdomain
# at an unreachable address, so we skip it rather than block the A update.
:local publicIp6 ""
:if ($doIpv6 = true) do={
  :do {
    :local ip6Result [/tool fetch url=$ipCheckUrl6 check-certificate=yes-without-crl output=user as-value]
    :if (($ip6Result->"status") = "finished") do={
      :set publicIp6 ($ip6Result->"data")
    }
  } on-error={}
  :if ($publicIp6 = "") do={
    :log warning "cf-push-ip: no IPv6 connectivity, AAAA record left unchanged"
  } else={
    :log info "cf-push-ip: public IPv6 is $publicIp6"
  }
}

# Wait for the clock to be NTP-synced before trusting it for the timestamp.
# Best-effort only: if it never syncs, we still proceed rather than blocking
# the actual IP update forever over a cosmetic timestamp.
:local clockAttempt 0
:local clockOk false
:while ($clockAttempt < $clockMaxAttempts and $clockOk = false) do={
  :set clockAttempt ($clockAttempt + 1)
  :if ([:tonum [:pick [/system clock get date] 0 4]] >= 2024) do={
    :set clockOk true
  } else={
    :delay $clockRetryDelay
  }
}
:if ($clockOk = false) do={
  :log warning "cf-push-ip: clock still not synced, comment timestamp may be inaccurate"
}

:local todayDate [/system clock get date]
:local nowTime   [/system clock get time]
:local timestamp ([:pick $todayDate 2 4] . "-" . [:pick $todayDate 5 7] . "-" . [:pick $todayDate 8 10] . " " . [:pick $nowTime 0 5])
:local cfComment ($commentName . " - " . $timestamp)

:log info "cf-push-ip: updating Cloudflare (comment: $cfComment)"

$pushRecord token=$cfApiToken zone=$cfZoneId record=$cfRecordId ip=$publicIp comment=$cfComment label="A"

:if ($publicIp6 != "") do={
  $pushRecord token=$cfApiToken zone=$cfZoneId record=$cfRecordId6 ip=$publicIp6 comment=$cfComment label="AAAA"
}
