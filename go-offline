# ============================================================
# Mark the Cloudflare records as offline (sentinel IPs), then
# power off this instance. Run this manually instead of using
# /system shutdown or the AWS console/CLI directly.
# Sentinels both the A record and, if an AAAA secret is
# configured, the AAAA record for the same subdomain - otherwise
# a v6-preferring resolver would still get a live-looking answer
# for a host that has shut down.
# Every failure path still shuts down: this is the shutdown
# command, so it must not become a no-op because DNS or the
# secret vault misbehaved.
# Requires: secret-vault run at boot (it defines $SECRET), with
#           secrets gooffline-apitoken, gooffline-zoneid,
#           gooffline-recordid, and optionally gooffline-recordid6
#           for the AAAA record. Seed them from the terminal with
#           $SECRET "set" "<name>" password="..."
# Policy: read, write, test, sensitive
#         "sensitive" is required to read the vault: policy is
#         enforced per the running script, not per secret-vault.
# ============================================================

# ---- Configurable variables ----
:local sentinelIp  "192.0.2.1"
:local sentinelIp6 "100::1"
:local maxAttempts 3
:local retryDelay  5s
:local shutdownDelay 10s
:local vaultMaxWait  20
# ---------------------------------

# Wait for secret-vault to define $SECRET. Unlike cf-push-ip this must not
# :error out if the vault never appears - that would skip the shutdown below,
# silently turning this command into a no-op. Log and carry on instead.
:global SecretVaultReady
:global SECRET
:local waited 0
:while ($SecretVaultReady != true && $waited < $vaultMaxWait) do={
  :delay 500ms
  :set waited ($waited + 1)
}

:local missing ""
:local cfApiToken  ""
:local cfZoneId    ""
:local cfRecordId  ""
:local cfRecordId6 ""

:if ($SecretVaultReady != true) do={
  :set missing " (secret-vault not ready)"
  :log error "go-offline: secret-vault not ready, skipping Cloudflare update"
} else={
  # $SECRET "get" raises on an unknown name, so each read is wrapped and an
  # empty result is treated the same as a missing one - both mean "unusable".
  :do { :set cfApiToken  [$SECRET "get" "gooffline-apitoken"] } on-error={}
  :do { :set cfZoneId    [$SECRET "get" "gooffline-zoneid"] } on-error={}
  :do { :set cfRecordId  [$SECRET "get" "gooffline-recordid"] } on-error={}
  :do { :set cfRecordId6 [$SECRET "get" "gooffline-recordid6"] } on-error={}

  :if ($cfApiToken = "") do={ :set missing ($missing . " gooffline-apitoken") }
  :if ($cfZoneId   = "") do={ :set missing ($missing . " gooffline-zoneid") }
  :if ($cfRecordId = "") do={ :set missing ($missing . " gooffline-recordid") }
  :if ($missing != "") do={
    :log error ("go-offline: missing secret(s):" . $missing . " - skipping Cloudflare update")
  }
}

# gooffline-recordid6 is deliberately optional, mirroring cf-push-ip: without
# it this stays a pure IPv4 updater, which is what v4-only hosts want.
:local doIpv6 true
:if ($cfRecordId6 = "") do={
  :set doIpv6 false
}

# PATCH one DNS record to its sentinel, retrying up to maxAttempts. RouterOS
# do={} functions do not capture outer :local variables, so everything it
# needs is passed in explicitly.
:local pushSentinel do={
  :local attempt 0
  :local success false
  :while ($attempt < $maxAttempts and $success = false) do={
    :set attempt ($attempt + 1)
    :do {
      :local updateResult [/tool fetch \
        url="https://api.cloudflare.com/client/v4/zones/$zone/dns_records/$record" \
        http-method=patch \
        http-header-field="Content-Type: application/json,Authorization: Bearer $token" \
        http-data="{\"content\":\"$ip\",\"comment\":\"offline\"}" \
        check-certificate=yes-without-crl \
        output=user as-value]
      :if ([:find ($updateResult->"data") "\"success\":true"] != nil) do={ :set success true }
    } on-error={}
    :if ($success = false and $attempt < $maxAttempts) do={ :delay $retryDelay }
  }
  :if ($success = true) do={
    :log info ("go-offline: " . $label . " record marked offline -> " . $ip)
  } else={
    :log warning ("go-offline: could not confirm " . $label . " update after " . $attempt . " attempt(s)")
  }
}

:if ($missing = "") do={
  $pushSentinel token=$cfApiToken zone=$cfZoneId record=$cfRecordId ip=$sentinelIp label="A" \
    maxAttempts=$maxAttempts retryDelay=$retryDelay
  :if ($doIpv6 = true) do={
    $pushSentinel token=$cfApiToken zone=$cfZoneId record=$cfRecordId6 ip=$sentinelIp6 label="AAAA" \
      maxAttempts=$maxAttempts retryDelay=$retryDelay
  }
}

:log info "go-offline: shutting down now"
:delay $shutdownDelay

/system shutdown
